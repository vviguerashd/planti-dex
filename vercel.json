{
  "rewrites": [
    {
      "source": "/((?!api/|alertas/|sprites/|scenes/|gala/|assets/|favicon|manifest|apple-touch|icon-).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/alertas",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/alertas",
      "schedule": "0 0 * * *"
    }
  ]
}